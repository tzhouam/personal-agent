[Unit]
Description=Repository-scoped GitHub Actions runner for Omni ReviewBot deploys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/project/.omni-reviewbot/runner
ExecStart=/home/ubuntu/project/.omni-reviewbot/runner/run.sh
KillMode=process
TimeoutStopSec=5min
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
